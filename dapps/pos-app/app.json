{
  "expo": {
    "name": "WalletConnect Pay",
    "slug": "mobile-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_icons/icon.png",
    "scheme": "wpay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.walletconnect.mobilepos",
      "appleTeamId": "W5R8AG9K22",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "WalletConnect Pay uses Bluetooth to connect to a thermal receipt printer so you can print transaction receipts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0666FF",
        "foregroundImage": "./assets/app_icons/android_icon_foreground.png",
        "backgroundImage": "./assets/app_icons/android_icon_background.png",
        "monochromeImage": "./assets/app_icons/android_icon_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.walletconnect.mobilepos",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.USB_PERMISSION"
      ],
      "versionCode": 3
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app_icons/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app_icons/splash_logo.png",
          "imageWidth": 270,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "android": {
            "image": "./assets/app_icons/splash_logo_android.png",
            "imageWidth": 288
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "note": "Use SENTRY_AUTH_TOKEN env to authenticate with Sentry.",
          "project": "mobile-pos-react-native",
          "organization": "walletconnect"
        }
      ],
      "./plugins/withAndroidVariants.js",
      "./plugins/withAndroidVariantIcons.js",
      "./plugins/withHceNfc.js",
      "./plugins/withHceFeatureFlag.js",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "KH Teka",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/KHTeka-Light.otf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/KHTeka-Regular.otf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/KHTeka-Medium.otf",
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "KH Teka Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/KHTekaMono-Regular.otf",
                    "weight": 400
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/KHTeka-Light.otf",
              "./assets/fonts/KHTeka-Regular.otf",
              "./assets/fonts/KHTeka-Medium.otf",
              "./assets/fonts/KHTekaMono-Regular.otf"
            ]
          }
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/images",
            "./assets/images/tokens",
            "./assets/images/chains",
            "./assets/images/payment_methods",
            "./assets/app_icons"
          ]
        }
      ],
      [
        "react-native-permissions",
        {
          "iosPermissions": ["Bluetooth"]
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ],
      "@sentry/react-native",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
