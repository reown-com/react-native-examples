# create .env
# These EXPO_PUBLIC_* vars are auto-loaded by the Expo CLI and inlined into the
# JS bundle at build time. They are PUBLIC (embedded in the bundle) — no secrets.

EXPO_PUBLIC_PROJECT_ID='39bc93c...'
EXPO_PUBLIC_SENTRY_DSN=''
EXPO_PUBLIC_TON_CENTER_API_KEY=''
EXPO_PUBLIC_BLOCKCHAIN_API_URL=''
EXPO_PUBLIC_TEST_PRIVATE_KEY=''
EXPO_PUBLIC_TEST_MODE=''
# Set to 'true' to compile in the dev agent: an RPC channel that E2E flows use to
# set up state and locate elements (see .maestro/agent/README.md). Deliberately a
# build-time decision rather than an __DEV__ check, so the binary under test is
# never one nobody chose to build. Leave blank for anything you ship.
EXPO_PUBLIC_DEV_AGENT=''
# Optional WCPay overrides — leave both blank for production. By default Pay
# talks to the production gateway and authenticates with EXPO_PUBLIC_PROJECT_ID.
# To test against another gateway (e.g. https://staging.api.pay.walletconnect.com),
# set its URL and the Pay app ID registered on that gateway, since the
# production project ID is not known there.
EXPO_PUBLIC_PAY_API_BASE_URL=''
EXPO_PUBLIC_PAY_APP_ID=''

# Build-time only (read by the Sentry gradle/xcode plugins, not by the JS bundle)
SENTRY_DISABLE_AUTO_UPLOAD=true

# Sentry auth token
SENTRY_AUTH_TOKEN=""